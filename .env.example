# =============================================================================
# MongoDB
# =============================================================================
# Modo Docker (replica set con autenticación). La API usa MONGODB_HOST y las
# credenciales de servicio; NO usa MONGODB_URI en runtime.
MONGODB_HOST=mongodb:27017
MONGODB_REPLICA_SET=rs0
MONGODB_AUTH_SOURCE=admin

# Base global y prefijo de las bases por almacén.
MONGODB_GLOBAL_DB=global_asistente_compras
MONGODB_ALMACEN_PREFIX=almacen_

# Secreto maestro para derivar las contraseñas de los almacenes con HMAC.
# Obligatorio, mínimo 32 caracteres. Cámbialo en producción.
MONGODB_WAREHOUSE_SECRET=replace-warehouse-secret-at-least-32-characters
# Solo durante la rotación. No lo pases como argumento de línea de comandos.
MONGODB_WAREHOUSE_SECRET_ANTERIOR=

# -----------------------------------------------------------------------------
# Inicialización y mantenimiento
# -----------------------------------------------------------------------------
# Credenciales del servidor MongoDB (solo mongo-init y scripts de mantenimiento).
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=replace-root-password
MONGO_REPLICA_HOST=mongodb:27017

# Usuarios de servicio de MongoDB. Cada uno tiene un rol nativo distinto.
MONGO_CLIENTE_USER=cliente_app
MONGO_CLIENTE_PASSWORD=replace-cliente-password
MONGO_ADMIN_APP_USER=admin_app
MONGO_ADMIN_APP_PASSWORD=replace-admin-app-password
MONGO_AUTH_USER=auth_service
MONGO_AUTH_PASSWORD=replace-auth-password
MONGO_VALIDADOR_USER=validador_catalogo
MONGO_VALIDADOR_PASSWORD=replace-validador-password
MONGO_CATALOGO_USER=replicador_catalogo
MONGO_CATALOGO_PASSWORD=replace-catalogo-password
MONGO_COMPRAS_USER=proyector_compras
MONGO_COMPRAS_PASSWORD=replace-compras-password
MONGO_PROVISIONER_USER=provisioner
MONGO_PROVISIONER_PASSWORD=replace-provisioner-password

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
# Cuenta inicial del administrador de la aplicación.
# Solo se crea si todavía no existe un administrador de la aplicación.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-admin-password
ADMIN_NOMBRE="Administrador de la aplicación"

# Orígenes permitidos por CORS (frontend de desarrollo).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Sesiones y límites.
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=1000
MAX_CSV_BYTES=1000000
MONGODB_TIMEOUT_MS=5000
LISTENER_REFRESH_SECONDS=15
LOG_LEVEL=INFO

# =============================================================================
# Imágenes de producto (Cloudinary)
# =============================================================================
# Credenciales del servidor de Cloudinary. La API sube los archivos; el
# navegador nunca recibe estas claves. Si no se configuran, los productos
# siguen funcionando sin imagen y los endpoints de imagen responden 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta raíz dentro de Cloudinary. Cada almacén usa un subprefijo propio.
CLOUDINARY_FOLDER=asistente-compras
# Tamaño máximo por imagen en bytes (2 MB por defecto).
MAX_PRODUCT_IMAGE_BYTES=2000000

# =============================================================================
# Pagos con Wompi (sandbox o producción)
# =============================================================================
# Sin llaves, la pasarela queda deshabilitada y el checkout responde 503:
# nunca se aprueban pagos sin validar.
# PAYMENTS_PROVIDER admite: wompi, fake (solo con MONGODB_MODO_PRUEBAS=true)
# o vacío/auto (usa Wompi si hay llaves).
PAYMENTS_PROVIDER=
PAYMENTS_SANDBOX=true
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# URL a la que Wompi devuelve al comprador. {reference} se reemplaza con la compra.
# Wompi añade ?id=<transacción>; el frontend lo usa para consultar el pago.
WOMPI_REDIRECT_URL=http://localhost:3000/pago/{reference}

# =============================================================================
# Cloudflare Tunnel para staging (opcional)
# =============================================================================
# No subas el token real al repositorio. Solo se usa en el servidor staging.
# Activa el túnel con:
# docker compose --profile staging up -d --build
CLOUDFLARE_TUNNEL_TOKEN=

# =============================================================================
# Solo pruebas y scripts
# =============================================================================
# Modo de pruebas: la API usa un único MONGODB_URI para todas las conexiones y
# no exige credenciales de servicio. Úsalo para pytest y scripts locales.
# MONGODB_MODO_PRUEBAS=true
# MONGODB_URI=mongodb://root:replace-root-password@127.0.0.1:27017/?authSource=admin&directConnection=true
