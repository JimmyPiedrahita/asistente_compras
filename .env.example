# MongoDB local. Con este docker-compose el host real es ``mongodb``.
MONGODB_URI=mongodb://root:replace-root-password@127.0.0.1:27017/?authSource=admin

# Base única de la aplicación.
MONGODB_DB=asistente_compras

# Credenciales del servidor MongoDB. No uses estos valores en producción.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=replace-root-password

# Cuenta inicial del administrador de la aplicación.
# Solo se crea si todavía no existe un administrador de la aplicación.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-admin-password
ADMIN_NOMBRE="Administrador de la aplicación"

# Orígenes permitidos por CORS (frontend de desarrollo).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Sesiones y límites.
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=1000
MAX_CSV_BYTES=1000000
MONGODB_TIMEOUT_MS=5000
LOG_LEVEL=INFO
