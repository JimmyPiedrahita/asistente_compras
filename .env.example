# MongoDB local. Para Change Streams debe ser un replica set.
# Con el docker-compose de este proyecto usa:
#   MONGODB_URI=mongodb://app_asistente:AppPass2026@127.0.0.1:27017/?directConnection=true&authSource=admin
# En Docker Compose el valor se sobrescribe con replicaSet=rs0 y authSource=admin.
MONGODB_URI="mongodb://app_asistente:replace-app-password@127.0.0.1:27017/?directConnection=true&authSource=admin"

# Obligatoria y sin valor por defecto. Usa al menos 8 caracteres.
ADMIN_CLAVE=replace-this-value

# Credenciales del servidor MongoDB (mongosh / Compass).
# MONGO_ROOT_PASSWORD es obligatoria; no existe valor por defecto.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=replace-root-password

# Usuario de servicio que usa la API y el listener.
MONGO_APP_USER=app_asistente
MONGO_APP_PASSWORD=replace-app-password

# Contraseña de los usuarios de demostración: u_cliente, u_proveedor,
# u_gerente y u_admin.
MONGO_DEMO_PASSWORD=replace-demo-password

# Host que mongo-init anuncia como miembro del replica set rs0 en Docker.
MONGO_REPLICA_HOST=mongodb:27017

# Prefijo de las bases fuente: warehouse_1, warehouse_2, ...
MONGODB_DB_PREFIX=warehouse

# Base integrada de solo lectura mantenida por Change Streams.
MONGODB_COMPARADOR_DB=comparador

# Base de roles y usuarios persistidos (colecciones roles y usuarios).
MONGODB_SEGURIDAD_DB=seguridad

# Opcional: ids y nombres de almacenes. Por defecto 1,2,3.
# WAREHOUSES=1:Centro,2:Norte,3:Sur

# Orígenes permitidos por CORS, separados por comas.
# El frontend de Vite usa http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Sesiones y límites.
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=1000
MAX_CSV_BYTES=1000000
MONGODB_TIMEOUT_MS=5000
LOG_LEVEL=INFO
