# MongoDB local. Para Change Streams debe ser un replica set.
# Con el docker-compose de este proyecto usa:
#   MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
# En Docker Compose el valor se sobrescribe con replicaSet=rs0.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true

# Obligatoria y sin valor por defecto. Usa al menos 8 caracteres.
ADMIN_CLAVE=replace-this-value

# Prefijo de las bases fuente: warehouse_1, warehouse_2, ...
MONGODB_DB_PREFIX=warehouse

# Base integrada de solo lectura mantenida por Change Streams.
MONGODB_COMPARADOR_DB=comparador

# Host que mongo-init anuncia como miembro del replica set rs0 en Docker.
MONGO_REPLICA_HOST=mongodb:27017

# Opcional: ids y nombres de almacenes. Por defecto 1,2,3.
# WAREHOUSES=1:Centro,2:Norte,3:Sur

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:3000

# Sesiones y límites.
SESSION_TTL_SECONDS=3600
MAX_SESSIONS=1000
MAX_CSV_BYTES=1000000
MONGODB_TIMEOUT_MS=5000
LOG_LEVEL=INFO
